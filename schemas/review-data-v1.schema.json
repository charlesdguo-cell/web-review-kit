{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-data-v1.schema.json",
  "title": "Review comments v1 (bare array; extension fields preserved)",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "id": {"type": "string"}, "number": {"type": "integer"},
      "text": {"type": "string"}, "status": {"enum": ["open", "changed", "resolved"]},
      "page": {"type": "object"}, "anchor": {"type": "object"},
      "screenshot": {"type": ["string", "null"]}, "attachments": {"type": "array"},
      "createdAt": {"type": "string"}, "updatedAt": {"type": "string"},
      "resolution": {"type": "string"}
    }
  }
}
