{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-review-kit.invalid/schemas/project-config.schema.json",
  "title": "Web Review Kit project configuration v1",
  "type": "object",
  "required": ["configVersion", "projectId", "toolVersion", "webRoot", "dataDir", "jobsDir", "server", "pageIdentity", "browserStorage", "guidance", "codex"],
  "properties": {
    "configVersion": {"const": 1},
    "projectId": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"},
    "toolVersion": {"$ref": "#/$defs/text", "description": "Explicit installed release version, or global to follow the verified installation current selection. Services and jobs freeze a concrete version."},
    "webRoot": {"$ref": "#/$defs/text"},
    "dataDir": {"$ref": "#/$defs/text"},
    "jobsDir": {"$ref": "#/$defs/text"},
    "server": {
      "type": "object", "required": ["port", "basePath", "publicOrigins"],
      "properties": {
        "host": {"enum": ["127.0.0.1", "0.0.0.0"], "default": "127.0.0.1"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "basePath": {"type": "string", "pattern": "^(|(/[a-zA-Z0-9_-]+)+)$"},
        "publicOrigins": {"type": "array", "items": {"type": "string", "pattern": "^https://[^/?#@]+$"}}
      }
    },
    "pageIdentity": {"type": "object"},
    "browserStorage": {"type": "object"},
    "guidance": {
      "type": "object", "required": ["requiredFiles", "sourceRoots", "buildCommands", "checkCommands"],
      "properties": {
        "requiredFiles": {"$ref": "#/$defs/strings"}, "sourceRoots": {"$ref": "#/$defs/strings"},
        "buildCommands": {"$ref": "#/$defs/commands"}, "checkCommands": {"$ref": "#/$defs/commands"}
      }
    },
    "codex": {
      "type": "object", "required": ["enabled", "executable", "approvalPolicy", "sandbox"],
      "properties": {
        "enabled": {"type": "boolean"}, "executable": {"$ref": "#/$defs/text"},
        "model": {"$ref": "#/$defs/text"}, "approvalPolicy": {"const": "never"},
        "sandbox": {"const": "danger-full-access"}
      }
    }
  },
  "allOf": [{
    "if": {"anyOf": [
      {"properties": {"server": {"properties": {"host": {"const": "0.0.0.0"}}, "required": ["host"]}}},
      {"properties": {"server": {"properties": {"basePath": {"minLength": 1}}}}},
      {"properties": {"server": {"properties": {"publicOrigins": {"minItems": 1}}}}}
    ]},
    "then": {"properties": {
      "server": {"properties": {"basePath": {"minLength": 1}, "publicOrigins": {"minItems": 1}}},
      "codex": {"properties": {"enabled": {"const": false}}}
    }}
  }],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "commands": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}}
  }
}
